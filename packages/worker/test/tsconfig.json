{
  // The test program (pigeon-4ogz.34): ../tsconfig.json covers src/ only. `npm run typecheck`
  // runs both. rootDir is the repo root because some tests import ../daemon/src.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-pool-workers"],
    "rootDir": "../..",
    "noEmit": true
  },
  // ../src is load-bearing even though tests import from it: Env is a `declare global` in
  // src/types.ts, which no test imports, and env.d.ts's ProvidedEnv extends it.
  "include": ["../src/**/*.ts", "./**/*.ts"],
  "exclude": []
}
